# Copy to .env.local and fill in. .env.local is gitignored.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered.
CONTACT_TO_EMAIL=contact@srimithraconstruction.com

# Sender. Must be an address on a domain verified in Resend; until the company
# domain is verified, Resend's shared test sender only delivers to the account
# owner's own address.
CONTACT_FROM_EMAIL="Srimithra Construction <onboarding@resend.dev>"

# Optional: the hero's secondary action plays this film when set.
NEXT_PUBLIC_HERO_VIDEO_URL=
