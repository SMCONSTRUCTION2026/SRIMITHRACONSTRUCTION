# Copy to .env.local and fill in. .env.local is gitignored.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered. Comma separate to send to more than one
# mailbox — worth doing so a single spam filter cannot swallow an enquiry.
CONTACT_TO_EMAIL=contact@srimithraconstruction.com

# Sender. Must be an address on a domain verified in Resend AND a mailbox that
# really exists on the domain's own mail host. A From address the receiving
# server knows is not real reads as forgery of its own domain and is filed as
# spam even when SPF, DKIM and DMARC all pass. Never use noreply@ here unless a
# mailbox or alias of that name actually exists. Replies reach the enquirer
# through Reply-To, so this address is not where answers land.
CONTACT_FROM_EMAIL="Sri Mithra Construction <contact@srimithraconstruction.com>"

# Optional: the hero's secondary action plays this film when set.
NEXT_PUBLIC_HERO_VIDEO_URL=
